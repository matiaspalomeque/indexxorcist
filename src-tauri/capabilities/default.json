{
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "window-state:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "core:webview:allow-print",
    "notification:default"
  ]
}
